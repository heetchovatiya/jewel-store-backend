# Jewel-Core Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3001
NODE_ENV=production

# MongoDB Connection
MONGODB_URI_BASE=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_PREFIX=priyincigold

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=https://your-store.vercel.app

# Email Configuration (for server scripts)
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# ============================================
# Cloudflare R2 (stay within free-tier Class A/B)
# ============================================
# Restricted API token: Object Read & Write on this bucket only.
# Never commit real keys.
R2_ACCESS_KEY_ID=your_restricted_access_key
R2_SECRET_ACCESS_KEY=your_restricted_secret_key
# https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=app-production-bucket
# Hostinger CNAME → R2 public bucket hostname (edge cache reduces Class B)
R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com
# Browser + CDN caching (1 year immutable) — cuts repeat Class B GETs
R2_CACHE_CONTROL=public, max-age=31536000, immutable

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Optional DB backup target (R2)
BACKUP_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/jewel_prod?retryWrites=true&w=majority
BACKUP_SPACE_NAME=app-production-bucket
BACKUP_S3_ENDPOINT=YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_TMP_DIR=./tmp_backups
