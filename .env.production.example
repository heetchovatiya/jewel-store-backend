PORT=3001
MONGODB_URI_BASE=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_PREFIX=priyincigold

# Required in production. Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

R2_ACCESS_KEY_ID=your_restricted_access_key
R2_SECRET_ACCESS_KEY=your_restricted_secret_key
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=app-production-bucket
R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com
R2_CACHE_CONTROL=public, max-age=31536000, immutable

# ============================================
# Blue Dart (delivery check, waybill, tracking)
# ============================================
# From the DHL/Blue Dart developer portal (My Apps → Consumer Key / Secret)
BLUEDART_ENABLED=true
# true = fake responses for local testing, no API calls
BLUEDART_MOCK=false
BLUEDART_BASE_URL=https://apigateway.bluedart.com/in/transportation
BLUEDART_CLIENT_ID=
BLUEDART_CLIENT_SECRET=
# From Blue Dart: login ID (your customer/login name), licence key(s) and API version number.
# Only one licence key? Put it in BLUEDART_SHIPPING_LICENCE_KEY (tracking falls back to it).
BLUEDART_LOGIN_ID=
BLUEDART_SHIPPING_LICENCE_KEY=
BLUEDART_TRACKING_LICENCE_KEY=
BLUEDART_API_VERSION=1.3
# Tracking without Client ID/secret uses the classic api.bluedart.com servlet automatically.
# Force with: legacy | gateway
# BLUEDART_TRACKING_MODE=
# Your Blue Dart account (needed for waybills)
BLUEDART_CUSTOMER_CODE=
BLUEDART_ORIGIN_AREA=
# Product: A = Apex (air). Sub-product: P = prepaid, C = COD
BLUEDART_PRODUCT_CODE=A
# 1 = parcel (non-document), 0 = documents
BLUEDART_PRODUCT_TYPE=1
BLUEDART_SUB_PRODUCT_PREPAID=P
BLUEDART_SUB_PRODUCT_COD=C
# Pickup cut-off HHMM (after this, default pickup date is the next day)
BLUEDART_PICKUP_TIME=1600
BLUEDART_DEFAULT_WEIGHT_KG=0.5
BLUEDART_DEFAULT_DIMENSIONS_CM=15x10x5
BLUEDART_COMMODITY_DESCRIPTION=Gold Jewellery
# Pickup / shipper address (each address line max 30 chars)
BLUEDART_SHIPPER_NAME=
BLUEDART_SHIPPER_ADDRESS1=
BLUEDART_SHIPPER_ADDRESS2=
BLUEDART_SHIPPER_ADDRESS3=
BLUEDART_SHIPPER_PINCODE=
BLUEDART_SHIPPER_MOBILE=
BLUEDART_SHIPPER_EMAIL=
BLUEDART_SHIPPER_GSTIN=
# Optional: RTO/return address (defaults to the shipper address)
# BLUEDART_RETURN_NAME=
# BLUEDART_RETURN_ADDRESS1=
# BLUEDART_RETURN_PINCODE=
# BLUEDART_RETURN_MOBILE=
# Mock-mode helpers (comma-separated PIN codes)
# BLUEDART_MOCK_UNSERVICEABLE=110001
# BLUEDART_MOCK_NO_COD=400001

# Extra allowed browser origins for CORS (comma-separated)
CORS_ORIGINS=
